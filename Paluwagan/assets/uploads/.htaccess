# Hide directory listing for uploads folder (prevents browsing all uploaded files)
Options -Indexes

# Protect the .htaccess file itself
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Security: Prevent execution of any scripts uploaded to this folder
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi|exe|dll|bat|cmd)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# You can still access individual files directly if you know the exact URL
# (this is how the app serves "View Document", payment receipts, etc.)
# If you need fully private access (login required), implement a PHP download proxy.